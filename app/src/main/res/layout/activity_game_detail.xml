<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/image_tap_area"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_image_rounded"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/cd_game_image" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:padding="6dp"
                    android:background="@drawable/bg_overlay_button"
                    android:src="@drawable/ic_expand"
                    android:contentDescription="@string/cd_expand_image"
                    app:tint="@color/white" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- حالت راهنمای یوتیوب — جایگزین کامل بخش‌های تنظیمات -->
                    <LinearLayout
                        android:id="@+id/youtube_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_card"
                        android:padding="28dp">

                        <ImageView
            android:importantForAccessibility="no"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_youtube"
                            app:tint="@color/accent_red" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="20dp"
                            android:gravity="center"
                            android:text="@string/youtube_hint"
                            android:textSize="15sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="4dp" />

                        <Button
                            android:id="@+id/watch_youtube_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="220dp"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:background="@drawable/bg_button_red"
                            android:text="@string/watch_on_youtube"
                            android:textAllCaps="false"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:drawableStart="@drawable/ic_play"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/white"
                            android:elevation="0dp"
                            android:stateListAnimator="@null" />

                    </LinearLayout>

                    <!-- تنظیمات بهینه سبز -->
                    <LinearLayout
                        android:id="@+id/green_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/TagChip"
                                android:background="@drawable/bg_tag_green"
                                android:text="@string/green_settings"
                                android:textColor="@color/tag_green" />

                            <LinearLayout
                                android:id="@+id/badge_green"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
            android:importantForAccessibility="no"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/tag_green" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/recommended_for_you"
                                    android:textColor="@color/tag_green"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/detail_settings_green"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_card"
                            android:padding="16dp"
                            android:lineSpacingExtra="6dp"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <!-- تنظیمات بهینه زرد -->
                    <LinearLayout
                        android:id="@+id/yellow_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/TagChip"
                                android:background="@drawable/bg_tag_yellow"
                                android:text="@string/yellow_settings"
                                android:textColor="@color/tag_yellow" />

                            <LinearLayout
                                android:id="@+id/badge_yellow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
            android:importantForAccessibility="no"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/tag_yellow" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/recommended_for_you"
                                    android:textColor="@color/tag_yellow"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/detail_settings_yellow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_card"
                            android:padding="16dp"
                            android:lineSpacingExtra="6dp"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
