<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/settings_scroll"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- نوار بالا -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="بازگشت"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/settings_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- بخش ظاهر برنامه (روشن / تیره / خودکار) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_theme"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <include
            android:id="@+id/theme_tiles"
            layout="@layout/view_theme_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- بخش زبان -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_language"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/language_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_card"
            android:paddingVertical="4dp">

            <RadioGroup
                android:id="@+id/language_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/lang_fa"
                    style="@style/SettingsRadio"
                    android:text="@string/lang_fa" />

                <View style="@style/SettingsDivider" />

                <RadioButton
                    android:id="@+id/lang_en"
                    style="@style/SettingsRadio"
                    android:text="@string/lang_en" />

            </RadioGroup>
        </LinearLayout>

        <!-- قدرت سیستم (کامپیوتر) کاربر -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_system_power"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:id="@+id/system_tier_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_card"
            android:paddingVertical="4dp">

            <RadioGroup
                android:id="@+id/system_tier_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/tier_weak"
                    style="@style/SettingsRadio"
                    android:text="@string/system_tier_weak" />

                <View style="@style/SettingsDivider" />

                <RadioButton
                    android:id="@+id/tier_medium"
                    style="@style/SettingsRadio"
                    android:text="@string/system_tier_medium" />

                <View style="@style/SettingsDivider" />

                <RadioButton
                    android:id="@+id/tier_strong"
                    style="@style/SettingsRadio"
                    android:text="@string/system_tier_strong" />

            </RadioGroup>
        </LinearLayout>

        <!-- فونت برنامه -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_font"
            android:textSize="13sp"
            android:textColor="@color/tag_yellow" />

        <LinearLayout
            android:id="@+id/font_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_card_glow_yellow"
            android:paddingVertical="4dp">

            <RadioGroup
                android:id="@+id/font_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- درباره -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/app_logo"
                android:background="@drawable/bg_image_rounded"
                android:clipToOutline="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PC Max Test"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/check_update_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_round_button"
                android:text="@string/check_for_update"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
