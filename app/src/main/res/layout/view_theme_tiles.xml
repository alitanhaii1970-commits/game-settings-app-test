<?xml version="1.0" encoding="utf-8"?>
<!-- سه کارت انتخاب تم (روشن / تیره / خودکار) با مینیاتور اپ؛ هم در ورود اولیه و هم در تنظیمات استفاده می‌شود -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/tile_theme_light"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_selectable_card"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/preview_theme_light"
            android:layout_width="72dp"
            android:layout_height="98dp"
            android:background="@drawable/bg_theme_preview_light" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/check_theme_light"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_check"
                android:visibility="invisible"
                app:tint="@color/accent_red" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tile_theme_dark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_selectable_card"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/preview_theme_dark"
            android:layout_width="72dp"
            android:layout_height="98dp"
            android:background="@drawable/bg_theme_preview_dark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/check_theme_dark"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_check"
                android:visibility="invisible"
                app:tint="@color/accent_red" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tile_theme_system"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_selectable_card"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/preview_theme_system"
            android:layout_width="72dp"
            android:layout_height="98dp"
            android:background="@drawable/bg_theme_preview_system" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_system"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/check_theme_system"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_check"
                android:visibility="invisible"
                app:tint="@color/accent_red" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
