<?xml version="1.0" encoding="utf-8"?>
<!-- مینیاتور اپ در تم dark — رنگ‌ها عمداً ثابت‌اند چون خودِ تم را نشان می‌دهند -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:autoMirrored="true">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E0E10" />
            <stroke android:width="1dp" android:color="#2A2A2E" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:top="10dp" android:start="9dp" android:gravity="top|start">
        <shape android:shape="rectangle">
            <size android:width="26dp" android:height="6dp" />
            <solid android:color="#F5F5F7" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:top="8dp" android:end="9dp" android:gravity="top|end">
        <shape android:shape="oval">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#E31E24" />
        </shape>
    </item>
    <item android:top="25dp" android:start="9dp" android:end="9dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <size android:height="12dp" />
            <solid android:color="#212124" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:top="43dp" android:start="9dp" android:end="9dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <size android:height="19dp" />
            <solid android:color="#18181B" />
            <stroke android:width="1dp" android:color="#2A2A2E" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:top="66dp" android:start="9dp" android:end="9dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <size android:height="19dp" />
            <solid android:color="#18181B" />
            <stroke android:width="1dp" android:color="#2A2A2E" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
